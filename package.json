{
  "name": "pi-orb",
  "version": "0.1.0-preview.2",
  "private": true,
  "type": "module",
  "description": "Electron desktop companion for pi-web: a floating orb window with an explicit, user-authorized desktop mode.",
  "license": "MIT",
  "author": "pi-orb contributors",
  "homepage": "https://github.com/rain-knows/pi-orb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rain-knows/pi-orb.git"
  },
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && node scripts/build-pi-plugin.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run build && electron-builder --config electron-builder.config.mjs --win --x64 --publish never",
    "package:win:dir": "npm run build && electron-builder --config electron-builder.config.mjs --win --x64 --publish never --dir",
    "verify:p0-baseline": "node evidence/p0-01/verify-baseline.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@playwright/mcp": "0.0.83",
    "koffi": "2.16.3",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.19.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "jsdom": "29.1.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "uiohook-napi@1.5.5": true,
    "koffi@2.16.3": true
  }
}
